generator client {
  provider = "prisma-client"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type String
  entity_id   String?   @db.Uuid
  action      String
  actor       String?   @default("system")
  status      String?   @default("success")
  metadata    Json?     @default("{}")
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model donations {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donation_id           String           @unique
  donor_id              String?          @db.Uuid
  donor_name            String
  donor_email           String
  amount                Decimal          @db.Decimal(12, 2)
  currency              String?          @default("USD")
  donation_date         DateTime         @db.Date
  campaign              String?
  designation           String?
  recurring_status      String?          @default("one_time")
  source                String?          @default("synthetic")
  acknowledgment_status donation_status? @default(received)
  created_at            DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?        @default(now()) @db.Timestamptz(6)
  donors                donors?          @relation(fields: [donor_id], references: [id], onUpdate: NoAction)
  drafts                drafts[]
  email_logs            email_logs[]

  @@index([donation_id], map: "idx_donations_donation_id")
  @@index([donor_email], map: "idx_donations_donor_email")
  @@index([acknowledgment_status], map: "idx_donations_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model donors {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donor_code        String?     @unique
  first_name        String
  last_name         String
  full_name         String?     @default(dbgenerated("((first_name || ' '::text) || last_name)"))
  email             String      @unique
  phone             String?
  address_line_1    String?
  city              String?
  state             String?
  country           String?
  postal_code       String?
  donor_type        donor_type? @default(unknown)
  lifetime_giving   Decimal?    @default(0) @db.Decimal(12, 2)
  total_gifts       Int?        @default(0)
  last_gift_amount  Decimal?    @db.Decimal(12, 2)
  last_gift_date    DateTime?   @db.Date
  recurring_status  Boolean?    @default(false)
  preferred_channel String?     @default("email")
  campaign_history  String[]
  stewardship_notes String?
  tags              String[]
  created_at        DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?   @default(now()) @db.Timestamptz(6)
  donations         donations[]
  drafts            drafts[]

  @@index([email], map: "idx_donors_email")
  @@index([donor_type], map: "idx_donors_type")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drafts {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donation_id            String?        @db.Uuid
  donor_id               String?        @db.Uuid
  donor_email            String
  draft_subject          String?
  draft_body             String
  edited_body            String?
  ai_reasoning           String?
  personalization_points Json?          @default("[]")
  risk_flags             Json?          @default("[]")
  match_status           match_status?  @default(no_match)
  match_confidence       Int?           @default(0)
  review_status          review_status? @default(pending_review)
  email_status           email_status?  @default(not_started)
  approved_by            String?
  approved_at            DateTime?      @db.Timestamptz(6)
  created_at             DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?      @default(now()) @db.Timestamptz(6)
  donations              donations?     @relation(fields: [donation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  donors                 donors?        @relation(fields: [donor_id], references: [id], onUpdate: NoAction)
  email_logs             email_logs[]

  @@index([donation_id], map: "idx_drafts_donation_id")
  @@index([email_status], map: "idx_drafts_email_status")
  @@index([review_status], map: "idx_drafts_review_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model email_logs {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id            String?       @db.Uuid
  donation_id         String?       @db.Uuid
  recipient_email     String
  subject             String?
  provider            String?
  status              email_status? @default(not_started)
  provider_message_id String?
  error_message       String?
  created_at          DateTime?     @default(now()) @db.Timestamptz(6)
  sent_at             DateTime?     @db.Timestamptz(6)
  donations           donations?    @relation(fields: [donation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  drafts              drafts?       @relation(fields: [draft_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_email_logs_status")
}

enum donation_status {
  received
  processing
  draft_created
  pending_review
  approved
  email_draft_created
  sent
  failed
  duplicate
}

enum donor_type {
  first_time
  repeat
  major
  recurring
  lapsed_returning
  anonymous
  unknown
}

enum email_status {
  not_started
  draft_created
  sent
  failed
  retry_pending
  cancelled
}

enum match_status {
  matched
  uncertain
  no_match
}

enum review_status {
  pending_review
  edited
  approved
  rejected
}
